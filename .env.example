# ==========================================
# KKI ATTENDANCE & PAYROLL SYSTEM CONFIGURATION
# Production Environment Variables for Render
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# ------------------------------------------
# Supabase Cloud Database Configuration (Primary Relational PostgreSQL)
# ------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Optional: Direct PostgreSQL Connection Pooler URL (for direct TCP pooling)
# DATABASE_URL=postgres://postgres.<your-project-ref>:<your-db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional: Supabase Management SQL API fallback (only if RPC/DATABASE_URL not configured)
# SUPABASE_PROJECT_REF=<your-project-ref>
# SUPABASE_ACCESS_TOKEN=<your-supabase-personal-access-token>

# Database Schema Isolation ('public' for Production, 'demo' for Demo Environment)
DB_SCHEMA=public

# ------------------------------------------
# Application Security Credentials (Strictly via Environment Variables)
# ------------------------------------------
# Master password for admin portal login
MASTER_PASSWORD=<your-strong-master-password>

# Password for unlocking payroll and salary calculation views
PAYROLL_PASSWORD=<your-strong-payroll-password>

# Base32 2FA secret key for Google Authenticator TOTP
TOTP_SECRET=<your-base32-totp-secret>

# ------------------------------------------
# AI Engine Configuration (Optional)
# ------------------------------------------
# GEMINI_API_KEY=<your-gemini-api-key>
